# iLO Control Script Environment

# JSON list of hosts. Add as many as you like.
ILO_HOSTS=[
  {"name":"server-1","host":"10.0.0.101","username":"Administrator","password":"REPLACE_ME"},
  {"name":"server-2","host":"10.0.0.102","username":"Administrator","password":"REPLACE_ME"},
  {"name":"server-3","host":"10.0.0.103","username":"Administrator","password":"REPLACE_ME"}
]

# Set false if you use iLO's self-signed certs (common). true if you have proper certs.
VERIFY_TLS=false

# Seconds
REQUEST_TIMEOUT=6
